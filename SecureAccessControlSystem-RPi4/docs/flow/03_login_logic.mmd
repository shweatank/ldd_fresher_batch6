flowchart TB
  L1([do_login]) --> L2[load_user strcmp username]
  L2 --> L3{Found?}
  L3 -->|No| L4[DENIED not registered]
  L3 -->|Yes| L5{lock_until > now?}
  L5 -->|Yes| L6[LOCKED]
  L5 -->|No| L7[verify_password hash strcmp]
  L7 -->|OK| L8[GRANTED]
  L7 -->|Fail| L9[attempts++]
  L9 --> L10{attempts >= 3?}
  L10 -->|Yes| L11[LOCKED 60s]
  L10 -->|No| L12[DENIED bad password]
  L4 --> L13[AUTH_RESULT + audit_log]
  L6 --> L13
  L8 --> L13
  L11 --> L13
  L12 --> L13
  L13 --> L14([Menu])

