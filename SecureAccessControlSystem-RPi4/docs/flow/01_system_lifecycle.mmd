flowchart LR
  subgraph P1["Phase 1 — Load driver"]
    direction TB
    A1([insmod secure_access_core.ko]) --> A2[Register platform driver]
    A2 --> A3[sac_probe]
    A3 --> A4[Locks, tasklet, workqueue]
    A4 --> A5[GPIO LEDs + TFT control]
    A5 --> A6[SPI ILI9225]
    A6 --> A7{IRQ?}
    A7 -->|Yes| A8[Request IRQ]
    A7 -->|No| A9[Software tasklet]
    A8 --> A9
    A9 --> A10[/dev/secure_access0]
    A10 --> A11[TFT SECURE ACCESS READY]
    A11 --> A12[/dev/uart]
    A12 --> A13([Driver ready])
  end

  subgraph P2["Phase 2 — Application"]
    direction TB
    B1([secure_access_app]) --> B2[SD users.db audit.log]
    B2 --> B3[open /dev/secure_access0]
    B3 --> B4[Menu 1–7]
    B4 --> B5{Choice}
    B5 -->|1–6| B6[Feature + ioctl sync]
    B6 --> B4
    B5 -->|7| B7[Exit CLEAR_TFT]
    B5 -->|other| B8[Invalid]
    B8 --> B4
    B7 --> B9([App end])
  end

  subgraph P3["Phase 3 — Unload"]
    direction TB
    C1([rmmod]) --> C2[sac_remove]
    C2 --> C3[Unregister UART misc]
    C3 --> C4[Destroy cdev + SPI]
    C4 --> C5([Done])
  end

  A13 --> B1
  B9 --> C1

