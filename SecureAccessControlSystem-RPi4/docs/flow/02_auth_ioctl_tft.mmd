%% Diagram 2 — App + kernel sync for each secured action
%%{init: {"theme":"base","themeVariables":{"lineColor":"#000000","arrowheadColor":"#000000","primaryBorderColor":"#000000","primaryColor":"#ffffff"}}}%%
flowchart TB
  subgraph APP["Userspace"]
    U1[User input] --> U2[ioctl AUTH_REQUEST]
    U2 --> U3[write auth_wait → AUTHENTICATING]
    U3 --> U4[Check SD: users.db hashes policy]
    U4 --> U5[ioctl AUTH_RESULT]
    U5 --> U6[ioctl WAIT_RESULT]
    U6 --> U7[Menu]
  end

  subgraph KERN["Kernel"]
    K1[Save auth_res] --> K2[Fire tasklet]
    K2 --> K3[Workqueue sac_auth_work_fn]
    K3 --> K4[strcmp reason → TFT message]
    K4 --> K5[SPI draw ILI9225]
    K3 --> K6[GPIO LED blink]
    K5 --> K7[wake WAIT_RESULT]
    K6 --> K7
  end

  U5 --> K1
  K7 --> U6

  linkStyle default stroke:#000000,stroke-width:2px
